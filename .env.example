# Copy to .env (never commit real values). Production secrets must come from a secret manager / platform identity.
NODE_ENV=development
PORT=4000
HOST=127.0.0.1
# Dev: run `pnpm dev:mongo` (single-node replica set, no Docker). The replica set name is printed by that script.
MONGODB_URI=mongodb://127.0.0.1:27017/?replicaSet=testset
# Atlas / hosted cluster instead (keep the real value only in your gitignored .env):
# MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=nexus
# dev = passwordless demo users (refused in production). oidc = single sign-on (docs/auth-oidc.md); required in production.
AUTH_MODE=dev
WEB_ORIGIN=http://localhost:5173

# --- OpenID Connect (only read when AUTH_MODE=oidc). Full reference: docs/auth-oidc.md ---
# OIDC_ISSUER=https://login.microsoftonline.com/<tenant-id>/v2.0
# OIDC_CLIENT_ID=<application-client-id>
# Prefer a mounted secret file over an environment variable. NEVER commit a real value.
# OIDC_CLIENT_SECRET_FILE=/run/secrets/nexus_oidc_client_secret
# OIDC_PROVIDER_NAME=Microsoft
# invite-only (default): only people an admin added can sign in.  jit: needs OIDC_DEFAULT_ORG_SLUG + OIDC_ALLOWED_EMAIL_DOMAINS.
# OIDC_PROVISIONING=invite-only
# OIDC_REQUIRE_EMAIL_VERIFIED=true
# Local development against the bundled mock provider (pnpm dev:idp) only:
# OIDC_ISSUER=http://127.0.0.1:9000
# OIDC_ALLOW_INSECURE_ISSUER=true

# --- credential storage (see docs/runbooks/secrets-and-kek-rotation.md) ---
# REQUIRED in production. 32 random bytes, base64:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# SECRETS_KEYS=2026-10:<base64>
# SECRETS_CURRENT_KEY_ID=2026-10
# Development only: a throwaway KEK is generated here when SECRETS_KEYS is unset.
SECRETS_DEV_KEY_FILE=.dev-secrets/kek.json

# --- outbound network policy for connectors (SSRF protection) ---
# Default: public addresses only. Loopback is for local development ONLY (refused in production).
NETWORK_ALLOW_LOOPBACK=true
# Approved private networks, comma-separated CIDRs (cloud metadata addresses stay blocked regardless).
NETWORK_ALLOW_PRIVATE_CIDRS=
# Allow plain http:// health-check targets (default false).
NETWORK_ALLOW_INSECURE_HTTP=false
CONNECTION_TEST_TIMEOUT_MS=30000

# --- worker (apps/worker) ---
WORKER_CONCURRENCY=8
WORKER_TICK_MS=5000
WORKER_HEALTH_PORT=4100

# --- ingestion service (apps/ingest) ---
# Standard OTLP/HTTP port. Senders POST to {INGEST_PUBLIC_URL}/v1/logs with Authorization: Bearer nxi_...
INGEST_PORT=4318
INGEST_HOST=127.0.0.1
INGEST_MAX_BODY_BYTES=4194304
INGEST_MAX_RECORDS_PER_REQUEST=5000
INGEST_TOKEN_RECORDS_PER_MINUTE=60000
INGEST_PROJECT_RECORDS_PER_MINUTE=200000
# Metric cardinality limits (one series = one label combination of one service instance)
METRIC_MAX_SERIES_PER_METRIC=2000
METRIC_MAX_SERIES_PER_ENVIRONMENT=20000
INGEST_MAX_INFLIGHT_WRITES=8
INGEST_MAX_QUEUED_WRITES=64
# Read by the API only: where the UI tells users to send telemetry.
INGEST_PUBLIC_URL=http://localhost:4318
