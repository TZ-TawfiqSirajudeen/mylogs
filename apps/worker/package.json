{
  "name": "@nexus/worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/main.ts",
    "start": "node dist/main.js",
    "build": "tsup",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@nexus/connections": "workspace:*",
    "@nexus/connector-sdk": "workspace:*",
    "@nexus/connectors": "workspace:*",
    "@nexus/database": "workspace:*",
    "@nexus/secrets": "workspace:*",
    "@nexus/security": "workspace:*",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "tsup": "^9.0.0",
    "tsx": "^4.23.15",
    "vitest": "^5.0.5"
  }
}
